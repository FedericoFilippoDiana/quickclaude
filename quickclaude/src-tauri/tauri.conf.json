{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickClaude",
  "version": "0.1.0",
  "identifier": "com.aymanalkait.quickclaude",
  "build": {
    "beforeDevCommand": "npm run build:agent && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:agent && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "QuickClaude",
        "width": 720,
        "height": 64,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true,
        "visible": false,
        "shadow": true,
        "windowEffects": {
          "effects": [
            "hudWindow"
          ],
          "state": "active",
          "radius": 14
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/quickclaude-agent"
    ],
    "resources": {
      "sounds/reply.mp3": "sounds/reply.mp3"
    }
  }
}
